# คัดลอกเป็น .env แล้วเติมค่า —  cp .env.example .env
# .env ถูก gitignore ไว้แล้ว ห้าม commit

# ===================== LINE Messaging API ==============================
# LINE Developers Console → channel ของ Messaging API
#   https://developers.line.biz/console/
#   - Messaging API → Channel access token (long-lived) → ปุ่ม Issue
#   - Basic settings → Channel secret
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- allowlist 3 ชั้น (คั่นด้วย comma) ---------------------------------
# คนละลิสต์กันจริง ๆ: ใส่ user ไม่ได้ทำให้คุยใน group ได้ ต้องใส่ group id ด้วย
# วิธีหา id: เปิด LINE_ALLOW_ALL_USERS=true ชั่วคราว ทักบอท แล้วดู
#   docker compose logs -f hermes | grep -i "line:"
# ⚠️ ห้ามเขียนคอมเมนต์ต่อท้ายบรรทัดค่าพวกนี้ — docker compose ไม่ตัด inline comment
#    ออกให้ ตัวคอมเมนต์จะกลายเป็นส่วนหนึ่งของค่าและเข้าไปอยู่ใน allowlist จริง ๆ
#    (เจอมาแล้วกับ LINE_ALLOWED_ROOMS)
# U0123... = แชทส่วนตัว
LINE_ALLOWED_USERS=
# C0123... = กลุ่ม
LINE_ALLOWED_GROUPS=
# R0123... = ห้องแบบหลายคนที่ไม่ใช่กลุ่ม
LINE_ALLOWED_ROOMS=

# ⚠️ true = ใครก็คุยกับบอทได้ ปิด allowlist ทั้ง 3 ชั้น
# ใช้ตอนเก็บ id รอบแรกเท่านั้น แล้วปิดกลับเป็น false
LINE_ALLOW_ALL_USERS=false

# ปลายทางของ cron / แจ้งเตือนที่บอทเป็นฝ่ายเริ่มเอง (ว่างได้)
LINE_HOME_CHANNEL=

# base URL https ที่ชี้กลับมาที่ container นี้ — ใช้ตอนส่งรูป/ไฟล์กลับเข้า LINE
# ต้องตรงกับโดเมนที่ตั้งใน tunnel/reverse proxy เช่น https://hermes-line.example.com
LINE_PUBLIC_URL=

# reply token ของ LINE อายุ ~60s  เกินกี่วินาทีถึงจะยิงปุ่ม postback ให้กดรับคำตอบ
# 0 = ปิด แล้วไปใช้ Push API แทนทุกครั้ง (Push กินโควตาข้อความของ OA)
LINE_SLOW_RESPONSE_THRESHOLD=45

# ===================== Model (LiteLLM gateway) =========================
# LiteLLM gateway — container llm-litellm บน network llm-clients
# ออก key แยกใบสำหรับ POC นี้:
#   ออก virtual key แยกใบจากฝั่ง LiteLLM (อย่าใช้ master key)
LITELLM_KEY=

# ใช้โดย config/config.yaml.tmpl ตอน ./scripts/init.sh
LITELLM_BASE_URL=http://llm-litellm:4000/v1
# main model — ต้องผ่าน ./scripts/probe-litellm.sh ทั้ง 3 ข้อ (ดู docs/MODEL-PROBE.md)
HERMES_MODEL=oc/gpt-oss-120b
HERMES_MAX_TURNS=60

# ===================== ทางเข้าจากอินเทอร์เน็ต ==========================
# LINE ยิง webhook ได้เฉพาะ https + โดเมนจริง เท่านั้น
# ทางที่ 1 — cloudflared:  docker compose --profile tunnel up -d
#   สร้าง tunnel ที่ https://one.dash.cloudflare.com → Networks → Tunnels
#   ingress ชี้ไปที่  http://hermes-line-agent:8646
CLOUDFLARE_TUNNEL_TOKEN=
# ทางที่ 2 — reverse proxy ของคุณเอง (ไม่ต้องใช้ token) ดูวิธีใน README.md

# ===================== Hermes ==========================================
# pin version เสมอ ห้ามใช้ latest
HERMES_VERSION=v2026.8.3
STACK_NAME=hermes-line
CONTAINER_PREFIX=hermes-line

# image รันด้วย user hermes UID 10000 — ตั้งให้ตรง `id -u` / `id -g` ของ owner ./data
PUID=1001
PGID=1001

# ===================== Network / port ==================================
# POC = 127.0.0.1 (ไม่เปิดออกเน็ตตรง ๆ)
BIND_ADDR=127.0.0.1
LINE_PORT=8646
GATEWAY_PORT=8642
DASHBOARD_PORT=9119

# ===================== Dashboard (optional) ============================
HERMES_DASHBOARD=0
DASHBOARD_USER=
DASHBOARD_PASS=

# ===================== Resource ========================================
MEM_LIMIT=4G
CPU_LIMIT=2.0
TZ=Asia/Bangkok

# path ที่ LINE Console ตั้งไว้ ต้องตรงกับ platforms.line.extra.webhook_path
LINE_WEBHOOK_PATH=/line/webhook
